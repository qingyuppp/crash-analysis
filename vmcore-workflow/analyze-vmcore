#!/usr/bin/env bash
set -euo pipefail

usage() { cat <<'EOF'
Usage: analyze-vmcore [--vmcore PATH] [--dmesg PATH] [--debuginfo PATH]
                      [--kernel PATH] [--output PATH]
EOF
}
die() { echo "analyze-vmcore: $*" >&2; exit 1; }
vmcore=/data/input/vmcore; dmesg=/data/input/dmesg; debuginfo=/data/input/debuginfo.rpm
kernel=/data/input/kernel; output=/data/output/analysis.md
while [[ $# -gt 0 ]]; do case "$1" in
  --vmcore) vmcore=${2:?}; shift 2;; --dmesg) dmesg=${2:?}; shift 2;;
  --debuginfo) debuginfo=${2:?}; shift 2;; --kernel) kernel=${2:?}; shift 2;;
  --output) output=${2:?}; shift 2;; -h|--help) usage; exit 0;; *) die "unknown argument: $1";; esac; done
[[ -r "$vmcore" ]] || die "vmcore is not readable: $vmcore"
[[ -r "$debuginfo" ]] || die "debuginfo rpm is not readable: $debuginfo"
[[ -d "$kernel" ]] || die "kernel source directory does not exist: $kernel"
outdir=$(dirname "$output"); mkdir -p "$outdir/focus"
raw="$outdir/crash-raw.txt"; evidence="$outdir/evidence.json"; queries="$outdir/queries.log"
workdir=/data/work/debug; rm -rf "$workdir"; mkdir -p "$workdir"
( cd "$workdir" && rpm2cpio "$debuginfo" | cpio -idmu --quiet )
vmlinux=$(find "$workdir/usr/lib/debug/lib/modules" -maxdepth 3 -type f -name vmlinux | head -n 1 || true)
[[ -r "$vmlinux" ]] || die "vmlinux not found after unpacking $debuginfo"
cmds="$outdir/crash.cmds"
printf '%s\n' 'set scroll off' sys log 'ps -m' 'bt -a' 'foreach UN bt' mod mount 'kmem -i' exit > "$cmds"
crash -i "$cmds" "$vmlinux" "$vmcore" > "$raw"
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
python3 /usr/local/lib/kernel-analysis/classify_evidence.py --crash "$raw" --out-dir "$tmp" --source crash
python3 - "$tmp" "$raw" "$evidence" "$vmcore" "$vmlinux" "$kernel" "$dmesg" "$outdir/focus" <<'PY'
import json, pathlib, re, sys
t, raw, out, vmcore, vmlinux, kernel, dmesg, focus = map(pathlib.Path, sys.argv[1:])
routing=json.loads((t/'routing.json').read_text()); tasks=json.loads((t/'task-index.json').read_text())
classification=json.loads((t/'classification.json').read_text()); text=raw.read_text(errors='replace')
bundle={'schema_version':1,'inputs':{'vmcore':str(vmcore),'vmlinux':str(vmlinux),'kernel':str(kernel),'dmesg':str(dmesg)},'classification':classification,'routes':routing['routes'],'groups':routing['groups'],'tasks':tasks['tasks']}
out.write_text(json.dumps(bundle, indent=2, sort_keys=True)+'\n')
focus.mkdir(exist_ok=True)
def write(name, pattern):
    lines=[line for line in text.splitlines() if re.search(pattern,line,re.I)]
    if lines: (focus/name).write_text('\n'.join(lines)+'\n')
if any(x['name']=='xfs_hang' for x in routing['routes']): write('xfs.txt', r'xfs|inodegc|xlog|TASK_UNINTERRUPTIBLE|^PID:|^COMMAND:')
if classification['primary_class']=='oops_panic': write('fault.txt', r'BUG:|Oops|WARNING|PANIC|RIP:|Call Trace')
if routing['groups'] and classification['primary_class']!='xfs_hang': write('hang.txt', r'TASK_UNINTERRUPTIBLE|blocked for more than|schedule|wait|^PID:|^COMMAND:')
PY
: > "$queries"
cat > "$output" <<EOF
# vmcore evidence bundle

Evidence was collected. Run the packaged linux-kernel-oops skill with:

- $evidence
- $outdir/focus/
- $queries

The skill may use /usr/local/bin/crash-query for iterative verification.
EOF
