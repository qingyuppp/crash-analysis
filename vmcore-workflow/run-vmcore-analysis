#!/usr/bin/env bash
set -euo pipefail
run_jc=1
if [[ ${1:-} == --no-jc ]]; then run_jc=0; shift; fi
analyze-vmcore "$@"
[[ $run_jc -eq 0 ]] && exit 0
command -v jc >/dev/null || { echo 'JoyCode CLI is unavailable' >&2; exit 1; }
echo '==> starting JoyCode skill analysis'
jc exec --json --sandbox danger-full-access --skip-git-repo-check '$linux-kernel-oops Read /data/output/evidence.json, then only the matching /data/output/focus/*.txt. Route automatically. For xfs_hang, batch bt for every route candidate PID with /usr/local/bin/crash-query --commands-file before selecting object queries; read queries.log after each batch. Use crash-query for all additional vmcore queries. Do not read crash-raw.txt unless a focused query cannot resolve uncertainty. Write /data/output/analysis.md.'
