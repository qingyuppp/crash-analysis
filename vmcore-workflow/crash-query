#!/usr/bin/env bash
set -euo pipefail
evidence=/data/output/evidence.json; command=; commands_file=; compact_bt=0
while [[ $# -gt 0 ]]; do case "$1" in
  --evidence) evidence=${2:?}; shift 2;; --command) command=${2:?}; shift 2;;
  --commands-file) commands_file=${2:?}; shift 2;;
  --compact-bt) compact_bt=1; shift;;
  -h|--help) echo 'Usage: crash-query [--evidence FILE] (--command "crash command" | --commands-file PATH) [--compact-bt]'; exit 0;; *) echo "unknown argument: $1" >&2; exit 2;; esac; done
[[ -r "$evidence" ]] || { echo 'evidence is required and must be readable' >&2; exit 2; }
[[ -z "$command" || -z "$commands_file" ]] || { echo '--command and --commands-file are mutually exclusive' >&2; exit 2; }
if [[ -n "$commands_file" ]]; then
  [[ -r "$commands_file" && -s "$commands_file" ]] || { echo 'commands file is not readable or is empty' >&2; exit 2; }
  command_text=$(<"$commands_file")
else
  [[ -n "$command" ]] || { echo 'one of --command or --commands-file is required' >&2; exit 2; }
  command_text=$command
fi
[[ $compact_bt -eq 0 || -n "$commands_file" ]] || { echo '--compact-bt requires --commands-file' >&2; exit 2; }
paths=()
while IFS= read -r path; do paths+=("$path"); done < <(python3 - "$evidence" <<'PY'
import json,sys
x=json.load(open(sys.argv[1]))['inputs']; print(x['vmlinux']); print(x['vmcore'])
PY
)
log="$(dirname "$evidence")/queries.log"
if [[ $compact_bt -eq 1 ]]; then
  raw=$(mktemp)
  trap 'rm -f "$raw"' EXIT
  printf '%s\nexit\n' "$command_text" | crash -i /dev/stdin "${paths[0]}" "${paths[1]}" > "$raw" 2>&1 || true
  { printf '\n## compact bt query\n\n```text\n%s\n```\n\n```text\n' "$command_text"; python3 - "$raw" <<'PY'
import re, sys
from collections import defaultdict

header = re.compile(r'^PID:\s*(\d+).*COMMAND:\s*"([^"]+)"')
frame = re.compile(r'^\s*#\d+\s+\[[^]]+\]\s+([^\s+]+)')
tasks, pid, comm, frames = [], None, None, []
def finish():
    if pid is not None:
        tasks.append((int(pid), comm, frames[:]))
for line in open(sys.argv[1], errors='replace'):
    match = header.match(line)
    if match:
        finish(); pid, comm, frames = match.group(1), match.group(2), []
        continue
    match = frame.match(line)
    if match and pid is not None:
        frames.append(match.group(1))
finish()

groups = defaultdict(list)
for pid, comm, frames in tasks:
    if 'xfs_buf_lock' not in frames:
        continue
    stack = frames[frames.index('xfs_buf_lock'):]
    if 'xfs_imap_to_bp' in stack:
        kind = 'inode_cluster'
    elif 'xfs_read_agf' in stack:
        kind = 'agf'
    elif 'xfs_read_agi' in stack:
        kind = 'agi'
    else:
        kind = 'other'
    groups[(kind, tuple(stack))].append((pid, comm))

print(f'direct_xfs_buf_lock_waiters: {sum(len(items) for items in groups.values())}')
for (kind, stack), items in sorted(groups.items()):
    print(f'kind: {kind}')
    print('pids: ' + ', '.join(str(pid) for pid, _ in sorted(items)))
    print('commands: ' + ', '.join(sorted({comm for _, comm in items})))
    print('frames: ' + ' > '.join(stack))
    print()
PY
    printf '```\n'; } >> "$log" 2>&1
else
  { printf '\n## crash query\n\n```text\n%s\n```\n\n```text\n' "$command_text"; printf '%s\nexit\n' "$command_text" | crash -i /dev/stdin "${paths[0]}" "${paths[1]}"; printf '```\n'; } >> "$log" 2>&1 || true
fi
printf '%s\n' "$log"
